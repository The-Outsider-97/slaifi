# SLAIFI backend
SLAIFI_ENVIRONMENT=development
SLAIFI_LOG_LEVEL=INFO
SLAIFI_API_HOST=127.0.0.1
SLAIFI_API_PORT=8000

# Market data
SLAIFI_MARKET_PROVIDER=mock
# Required when SLAIFI_MARKET_PROVIDER=twelvedata
SLAIFI_MARKET_API_KEY=
SLAIFI_MARKET_HTTP_TIMEOUT_SECONDS=10
SLAIFI_MARKET_QUOTE_CACHE_TTL_SECONDS=5
SLAIFI_MARKET_HISTORY_CACHE_TTL_SECONDS=60
# Override only when needed; pydantic-settings expects a JSON array for tuple fields.
# SLAIFI_MARKET_OVERVIEW_SYMBOLS=["SPY","QQQ","DIA","VIX"]

# Optional actual portfolio ledger. Use an absolute path valid on the host machine.
# SLAIFI_PORTFOLIO_FILE=/path/to/portfolio.json

# SLAI integration
SLAIFI_SLAI_ENABLED=true
SLAIFI_SLAI_REQUIRED=false
SLAIFI_SLAI_REASONING_AGENT=reasoning
SLAIFI_SLAI_QUALITY_ENABLED=true
SLAIFI_SLAI_QUALITY_AGENT=quality
SLAIFI_SLAI_QUALITY_REFINEMENT_ENABLED=true
SLAIFI_SLAI_SAFETY_ENABLED=true
SLAIFI_SLAI_SAFETY_AGENT=safety
SLAIFI_SLAI_MEMORY_TTL_SECONDS=900

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
