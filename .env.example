# SLAIFI backend
SLAIFI_ENVIRONMENT=development
SLAIFI_LOG_LEVEL=INFO
SLAIFI_API_HOST=127.0.0.1
SLAIFI_API_PORT=8777

# Market data -----------------------------------------------------------------------------------
# SLAIFI shows only real data. It asks the sources below in order and uses the first that answers.
# If none can be reached it shows the last real observation it saved (labelled LAST KNOWN DATA,
# with the time it was observed); if it has none, it says NOT AVAILABLE. Nothing is ever invented.
#
# Each source needs its own FREE key. Set at least three for good coverage; any subset works.
#   Twelve Data   https://twelvedata.com/pricing          8 req/min, 800/day
#   Tiingo        https://www.tiingo.com                  50 req/hour, 1000/day
#   FMP           https://site.financialmodelingprep.com  250 req/day
#   Finnhub       https://finnhub.io                      60 req/min (quotes and search)
#   Alpha Vantage https://www.alphavantage.co/support     25 req/day (last resort)
# Copy this file to `.env` next to it (applications\slaifi\.env) and fill in the keys. The same lines also work
# in <SLAI root>\.env (only SLAIFI_* lines are read there) or in the environment. Restart SLAIFI after editing.
# Keys are secrets: they are never logged, returned by the API or shown in the UI.
SLAIFI_TWELVEDATA_API_KEY=
SLAIFI_TIINGO_API_KEY=
SLAIFI_FMP_API_KEY=
SLAIFI_FINNHUB_API_KEY=
SLAIFI_ALPHAVANTAGE_API_KEY=
# Order in which sources are asked (names above, lower case, comma separated).
# SLAIFI_MARKET_PROVIDER_ORDER=twelvedata,tiingo,fmp,finnhub,alphavantage
# Only if your plan differs from the free tier (JSON; per_minute / per_hour / per_day per source).
# SLAIFI_MARKET_LIMITS={"twelvedata":{"per_minute":55,"per_day":100000}}
SLAIFI_MARKET_HTTP_TIMEOUT_SECONDS=10
SLAIFI_MARKET_QUOTE_CACHE_TTL_SECONDS=60
SLAIFI_MARKET_HISTORY_CACHE_TTL_SECONDS=300
# SLAIFI_MARKET_OVERVIEW_SYMBOLS=["SPY","QQQ","DIA","VIX"]
# Known provider delay in minutes (e.g. 15 on a delayed plan). Unset = unknown, reported as such.
# SLAIFI_MARKET_DATA_DELAY_MINUTES=15

# Where the paper-trading ledger (SQLite), backups and audit log live.
# Default: SLAI's per-application data folder (%LOCALAPPDATA%\SLAI\SLAIFI on Windows,
# $XDG_DATA_HOME/slai/slaifi elsewhere).
# Built web UI served by the API (default <slaifi>/dist, built by `npm run build`)
# SLAIFI_FRONTEND_DIST_DIR=
# SLAIFI_DATA_DIR=G:\GAIA\AI\SLAI\data\slaifi
# (also holds market_cache.db: the last real quotes/history, so they survive a restart)

# Paper trading rules (real-money trading does not exist and cannot be enabled)
SLAIFI_PAPER_ALLOW_CLOSED_MARKET_EXECUTION=false
SLAIFI_PAPER_MAX_QUOTE_AGE_SECONDS=900
# Mutating requests must carry the X-SLAIFI-Client header (the bundled UI sends it).
SLAIFI_API_REQUIRE_CLIENT_HEADER=true

# Optional actual portfolio ledger
# SLAIFI_PORTFOLIO_FILE=G:\GAIA\AI\SLAI\data\slaifi\portfolio.json

# SLAI integration
SLAIFI_SLAI_ENABLED=true
SLAIFI_SLAI_REQUIRED=false
SLAIFI_SLAI_REASONING_AGENT=reasoning
SLAIFI_SLAI_QUALITY_ENABLED=true
SLAIFI_SLAI_QUALITY_AGENT=quality
SLAIFI_SLAI_QUALITY_REFINEMENT_ENABLED=true
SLAIFI_SLAI_MEMORY_TTL_SECONDS=900
# Optional agents are off until switched on in Settings. These only set the first-start default.
SLAIFI_SLAI_KNOWLEDGE_ENABLED=false
SLAIFI_SLAI_OPTIMIZATION_ENABLED=false
SLAIFI_SLAI_LEARNING_ENABLED=false
# SLAIFI_SLAI_KNOWLEDGE_AGENT=knowledge
# SLAIFI_SLAI_OPTIMIZATION_AGENT=optimization
# SLAIFI_SLAI_LEARNING_AGENT=learning

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
